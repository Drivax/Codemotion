{
  "$defs": {
    "DataFlowGraph": {
      "properties": {
        "function_id": {
          "title": "Function Id",
          "type": "string"
        },
        "entry": {
          "title": "Entry",
          "type": "string"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/FlowOperation"
          },
          "title": "Operations",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/FlowLink"
          },
          "title": "Edges",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "function_id",
        "entry",
        "operations",
        "edges"
      ],
      "title": "DataFlowGraph",
      "type": "object"
    },
    "Diagnostic": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "FileRecord": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "package": {
          "title": "Package",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "parsed": {
          "default": true,
          "title": "Parsed",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "package",
        "source"
      ],
      "title": "FileRecord",
      "type": "object"
    },
    "FlowLink": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "kind": {
          "default": "control",
          "enum": [
            "control",
            "data"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "FlowLink",
      "type": "object"
    },
    "FlowOperation": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceLocation"
        },
        "reads": {
          "items": {
            "type": "string"
          },
          "title": "Reads",
          "type": "array"
        },
        "writes": {
          "items": {
            "type": "string"
          },
          "title": "Writes",
          "type": "array"
        },
        "definitions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Definitions",
          "type": "object"
        },
        "literal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Literal"
        },
        "calls": {
          "items": {
            "type": "string"
          },
          "title": "Calls",
          "type": "array"
        },
        "explanation": {
          "default": "",
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "expression",
        "source"
      ],
      "title": "FlowOperation",
      "type": "object"
    },
    "GraphEdge": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "resolution": {
          "$ref": "#/$defs/Resolution",
          "default": "resolved"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "kind"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphNode": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "qualified_name": {
          "title": "Qualified Name",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "signature": {
          "default": "",
          "title": "Signature",
          "type": "string"
        },
        "docstring": {
          "default": "",
          "title": "Docstring",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "qualified_name"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "Repository": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "snapshot": {
          "title": "Snapshot",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "snapshot"
      ],
      "title": "Repository",
      "type": "object"
    },
    "Resolution": {
      "enum": [
        "resolved",
        "candidate",
        "unresolved",
        "external"
      ],
      "title": "Resolution",
      "type": "string"
    },
    "SourceLocation": {
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "default": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "default": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_column": {
          "default": 0,
          "title": "Start Column",
          "type": "integer"
        },
        "end_column": {
          "default": 0,
          "title": "End Column",
          "type": "integer"
        }
      },
      "required": [
        "file"
      ],
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "repository": {
      "$ref": "#/$defs/Repository"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileRecord"
      },
      "title": "Files",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/GraphNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/GraphEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "flows": {
      "additionalProperties": {
        "$ref": "#/$defs/DataFlowGraph"
      },
      "title": "Flows",
      "type": "object"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    }
  },
  "required": [
    "repository"
  ],
  "title": "Analysis",
  "type": "object"
}